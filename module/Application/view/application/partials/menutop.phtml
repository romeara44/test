
<ul>
    <?php foreach ($items as $item): ?>
        <li id="<?php echo isset($item['active']) ? 'current' : '' ?>" class="<?php echo (isset($item['disabled']) ? 'disabled ' : '')?><?php echo (isset($item['items']) ? 'drop-down' : '')?>">
            <a href="<?php echo isset($item['items']) || (!isset($item['items']) && isset($item['disabled'])) ? 'javascript:;' : $item['url'] ?>"><?php echo $item['title'] ?></a>
            <?php if(isset($item['items'])) {?>
                <ul>
                    <?php foreach ($item['items'] as $value) {?>
                        <li <?php if(isset($value['disabled'])) {?> class="disabled" disabled="disabled"<?php }?>><a href="<?php echo isset($item['disabled']) ? 'javascript:;' : $value['url'] ?>"><?php echo $value['title'] ?></a></li>
                    <?php } ?>
                </ul>
            <?php } ?>
        </li>
    <?php endforeach; ?>
</ul>

<!-- END RENDER MENU -->