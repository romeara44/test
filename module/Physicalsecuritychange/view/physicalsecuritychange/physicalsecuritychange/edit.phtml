<script type="text/javascript">
    $(document).ready(function() {
        $('#physicalsecuritychange').validate();

        var browseFilesCounter = 0;
        
        $('#browseFile').click(function() {
            $('#filesToUploadBox').append('<div><input type="file" name="notesFiles[]" id="file' + browseFilesCounter + '" /><div class="cboth"></div></div>');

            $('#file' + browseFilesCounter).click();
            browseFilesCounter++;
        });

        $("#company").change(function(){
            getCompanyLocations()
        });

        function getCompanyLocations()
        {
            var cId = $("#company option:selected").val();
            
            if(cId != undefined && cId != '') {
                $.ajax({
                    type:"GET",
                    url:"/company/getAddresses/" + cId,
                    dataType: 'json',
                    success: function(data){
                        var html = '<option value="">Please Select</option>';
                        $.each(data, function(index, value) {
                            html += '<option value="' + value[0].adr_id + '">Location ' + value[0].adr_id + '</option>';
                        });
                        $('#location').html(html);
                    }
                });
            }
        }

        $('.buttonAdd').click(function ()  {
           var counter = parseInt($("#psc-items tr:last td:first").text());
           if(isNaN(counter)) counter = 0;
           ++counter;
           var temp = $("#psc-items-row").clone();
           temp.find('input').each(function(indx, elem) {
            $(elem).prop('name', $(elem).prop('name').replace('_items[new][0]', '_items[new][' + counter + ']').replace('[pscidate]', '[psci_date]'));
           });
           temp.removeAttr("id").show().appendTo($("#psc-items-row").parent());
           $("#psc-items tr:last td:first").text(counter + '.');
           $("#psc-items tr:last td:nth-child(2) input").datepicker({dateFormat: 'mm/dd/yy'});
       });

        $('#psc-items').on('click', '.deleteIaiiTableRow', function() {
            $(this).closest('tr').remove();
       });

        $( "#psc-items input[name*='psci_date']").datepicker({dateFormat: 'mm/dd/yy'});
    });
</script>
