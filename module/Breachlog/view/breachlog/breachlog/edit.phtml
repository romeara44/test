<script type="text/javascript">
    jQuery(function() {
        //$('#breachlog').validate();
        $('input[name="u_zip"]').mask("99999");
        //$('input[name="bl_size"]').mask("99999");

        $('#q22, #q21').change(function() {
            var isChecked = $('#q22').attr('checked');
            if (isChecked == 'checked') {
                $('#q32, #q31').parent().hide().end().prop('disabled', true);
            } else {
                $('#q32, #q31').parent().show().end().prop('disabled', false);
            }
        });

        $('#q22, #q21').change();
        $('#bl_size').change(function(){
            if(parseFloat($('#bl_size').val()) >= 500) {
                $('#q102').attr('checked', 'checked');
            } else {
                $('#q101').attr('checked', 'checked');
            }
        });
        
        $("#company").change(function(){
            getCompanyUsers()
        });

        function getCompanyUsers()
        {
            var cId = $("#company option:selected").val();
            
            if(cId != undefined && cId != '') {
                $.ajax({
                    type:"GET",
                    url:"/breachlog/getcompanyusers/" + cId,
                    success: function(data){
                        var html = '<option value="">Please Select</option>';
                        $.each(data, function(index, value) {
                            html += '<option value="' + value.u_id + '">' + value.u_firstname + ' ' + value.u_lastname + '</option>';
                        });
                        $('#bl_accepter_u_id, #bl_approver_u_id').html(html);
                    }
                });
            }
        }
        
        var browseFilesCounter = 0;
        
        $(document).ready(function() {
            $('#browseFile').click(function() { 
                if(browseFilesCounter > 0) {
                    var prevFile = $('#file' + (browseFilesCounter - 1)).val();
                    if(prevFile == undefined || prevFile == '') {
                        $('#file' + (browseFilesCounter - 1)).click();
                        return;
                    }
                }
                
                $('#filesToUploadBox').append('<input type="file" name="notesFiles[]" id="file' + browseFilesCounter + '" />');

                $('#file' + browseFilesCounter).click();
                browseFilesCounter++;
            });
            
            $( "#bl_date_of_occurrence, #bl_date_invest_start, #bl_date_invest_complete" ).datepicker({dateFormat: 'mm/dd/yy'});

            if(parseFloat($('#bl_size').val()) >= 500) {
                $('#q102').attr('checked', 'checked');
            } else {
                $('#q101').attr('checked', 'checked');
            }
            
           var locked = <?php echo json_encode($breach_locked_local); ?>;
           
           if (locked == true){
            $("#_regulations_table").find("input,button,textarea,select").attr("disabled", "disabled");
           }

        });

        function searchRegulations()
        {
            var value = $('#_search_regulation').val().toLowerCase();
            if (value) {
                $('#_regulations_table tbody tr').hide();
                $('#_regulations_table th:nth-child(3), #_regulations_table td:nth-child(3)').show();
                $('#_regulations_table tbody td').each(function(i, v) {
                    var $td = $(v);
                    if ($td.text().toLowerCase().indexOf(value) != -1) {
                        $td.closest('tr').show();
                    }
                });
            } else {
                $('#_regulations_table th:nth-child(3), #_regulations_table td:nth-child(3)').hide();
                $('#_regulations_table tbody tr').show();
            }
        }

        $('#_search_regulation').keyup(function(){
            searchRegulations();
        });
        searchRegulations();

        $('#_regulations_table tbody tr').click(function() {
            
            if (!$("input[name='bl_name").prop("disabled"))
            {
                $(this).toggleClass('tr-selected');
            }
                        
            regulationHandle();
        });

        function regulationHandle()
        {
            $('div[id^=_regulation_wrap_]').css('display', 'none');

            $('#_regulations_table tbody tr').each(function(i, v){
                if ($(v).hasClass('tr-selected')) {
                    $('#_regulation_wrap_' + $(v).prop('id')).css('display', 'block');
                }
            });
        }

        var cur_regulations_hidden = $('#_bl_cur_regulations_hidden').val();
        if (cur_regulations_hidden) {
            var cur_regulations = cur_regulations_hidden.split(',');
            for (var i = 0; i <  cur_regulations.length; i++) {
                $('#_regulations_table tbody tr#' + cur_regulations[i]).toggleClass('tr-selected');
            };
            regulationHandle();
        }

        $('#breachlog').submit(function(e) {
            
            var is102Checked = $('#q102').attr('checked');
            if (is102Checked == 'checked') {
                $("#q102").prop("disabled", false);
                $("#q101").prop("disabled", true);
            }
            var is101Checked = $('#q101').attr('checked');
            if (is101Checked == 'checked') {
                $("#q101").prop("disabled", false);
                $("#q102").prop("disabled", true);
            }

            var value = '';
            $('#_regulations_table tbody tr.tr-selected').each(function(i, v) {
                value += $(v).prop('id') + ',';
            });
            if (value) {
                value = value.slice(0, -1);
            }
            $('#_bl_cur_regulations_hidden').val(value);

        });
    });
</script>
