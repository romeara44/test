                }
            } else {
                if(jQuery('#attachments' + idA).is(':visible')) {                    
                    jQuery('#attachments' + idA + ', #fileupload' + idA).slideUp(function(){
                    });
                } else {
                    jQuery('#notes' + idA).slideUp(function(){
                        jQuery('#attachments' + idA + ', #fileupload' + idA).delay(600).slideDown();
                    });
                }
            }
            
        });
        
        $('#save_button, #save_and_copy_button').click(function() {
            $('#signedoff, #requestreview').val('');
            $('.valid_input').removeClass('required');
            $('#formNote').submit();
        });
        
        $('#requestreview_button').click(function() {
            $('#signedoff').val('');
            $('#requestreview').val(1);
            $('.valid_input').removeClass('required');
            $('#formNote').submit();
        });
        
        $('#sign-off-btn-yes').click(function() {
            jQuery.fancybox.close();
            $('#requestreview').val('');
            $('#signedoff').val(1);
            $('#signedoff_clone').val(1);
            $('.valid_input').addClass('required');
            $('#formNote').submit();
        });

        $('#sign-off-btn-no').click(function() {
            jQuery.fancybox.close();
            $('#requestreview').val('');
            $('#signedoff_clone').val('');
            $('#signedoff').val(1);
            $('.valid_input').addClass('required');
            $('#formNote').submit();
        });
        
        $('#formNote').submit(function() {
            
            var isValid = $('#formNote').valid();

            if (isValid) {
                return true;
            }
            return false;
        });

        jQuery('#signedoff_button').fancybox({
            'href' : '#confirmation-sign-off-modal',
            'width': '500',
            'autoDimensions': false,
            'hideOnContentClick': false,
            'closeBtn': false,
            'helpers' : {
                'overlay' : {
                    'closeClick': false,
                    'locked': false
                }
            },
            'keys' : {
                close  : null
            },
            'beforeShow': function () {
                jQuery.fancybox.wrap.bind("contextmenu", function (e) {
                    return false;
                });
            }
        });

        $('body').on('click', '.ajax-link', function(e) {
            e.preventDefault();
            $.ajax({
                type:"POST",
                url:$(this).prop('href'),
                success: function(data){
                    if (data == '1') {
                        location.reload();
                    } else {
                        alert(data);
                    }
                }
            });
        });

        $('a.draggable').each(function( index, value ) {
          value.addEventListener('dragstart',function(evt){
            evt.dataTransfer.setData('DownloadURL',$(value).data('downloadurl'));
          },false);
        });

        jQuery('.fancybox').each(function() {
    
            var width = jQuery(this).attr("width");
            if (!width) width = 700;
        
            jQuery(this).fancybox({
                'width': width,
                'autoDimensions': false,
                'type': 'iframe',
                afterClose:function(){
                    window.location.reload();
                }
            });
            
        });

        $('tr.editable td').click(function() {
            var td = $(this), edit_row = $('#edit-row');
            if (td.hasClass('edit-mode') || td.index() >= edit_row.children().length) {
                return;
            }
            $('tr.editable .edit-cancel').trigger('click');
            td.addClass('edit-mode');
            var old_val = td.html();
            td.html('<span class="old-val">' + old_val + '</span>' + edit_row.children().eq(td.index()).children().clone().wrap('<div></div>').wrap('<form></form>').parent().parent().html() + '<a href="#" class="edit-save">Save</a> <a href="#" class="edit-cancel">Cancel</a>');
            var elem = td.find('form').children();
            if (elem.is('input')) {
                elem.val(old_val);
            }
            if (elem.is('select')) {
                elem.find('option').filter(function() {
                    return $(this).text() == old_val; 
                }).prop('selected', true);
            }
            if (elem.hasClass('datepicker')) {
                elem.datepicker({dateFormat: 'mm/dd/yy'});
            }
        });

        $('tr.editable').on('click', '.edit-cancel', function(e) {
            e.preventDefault();
            var td = $(this).closest('td');
            td.html(td.children('span.old-val').html()).removeClass('edit-mode');
        });

        $('tr.editable').on('click', '.edit-save', function(e) {
            e.preventDefault();
            var td = $(this).closest('td');
            var url = '/remediationplan/savetaskfield/' + td.closest('tr').data('id');
            $.ajax({
                type:"POST",
                url:url,
                data:td.find('form').serialize(),
                success: function(data){
                    if (data == '1') {
                        var elem = td.find('form').children();
                        if (elem.is('input')) {
                            td.html(elem.val()).removeClass('edit-mode');
                        }
                        if (elem.is('select')) {
                            td.html(elem.find('option:selected').text()).removeClass('edit-mode');
                        }
                    } else {
                        alert('Error');
                    }
                }
            });
        });

        jQuery('.fileupload').each(function() {
            $(this).fileupload({
                dropZone: $(this),
                dataType: 'json',
                done: function (e, data) {
                    var tr = $(this).closest('tr').next('tr');
                    tr.html(data.result.html);    
                    tr.find('a.draggable').each(function( index, value ) {
                      value.addEventListener('dragstart',function(evt){
                        evt.dataTransfer.setData('DownloadURL',$(value).data('downloadurl'));
                      },false);
                    });  
                    tr.find('.confirmation-modal').each(function() {
                        $(this).fancybox({
                            'width': '500',
                            'autoDimensions': false,
                            'hideOnContentClick': false,
                            'closeBtn': false,
                            'helpers' : {
                                'overlay' : {
                                    'closeClick': false
                                }
                            },
                            'keys' : {
                                close  : null
                            },
                            'beforeShow': function () {
                                $.fancybox.wrap.bind("contextmenu", function (e) {
                                    return false;
                                });
                            }
                        });
                    });       
                },
                progressall: function (e, data) {
                    var progress = parseInt(data.loaded / data.total * 100, 10);
                    var bar1 = $(this).closest('td').find('.progress');
                    var bar2 = bar1.find('.progress-bar');

                    bar1.removeClass('hidden');
                    bar2.css({
                        width : progress + '%'
                    });

                    if(progress === 100) {
                        bar2.css({
                         width : 0
                        });
                        bar1.addClass('hidden');
                    }
                }
            });
        });
    });

</script>

