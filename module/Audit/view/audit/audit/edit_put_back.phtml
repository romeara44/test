<script type="text/javascript">

    var browseFilesCounter = 0;
    jQuery(document).ready(function() {
        $('#browseFile').click(function() {
            $('#filesToUploadBox').append('<input type="file" name="notesFiles[]" id="file' + browseFilesCounter + '" /><br />');

            $('#file' + browseFilesCounter).click();
            browseFilesCounter++;
        });
        
        openEditTask();
    });
    
    function openEditTask()
    {
        var get = parseGET();
        if(get['edittask'] != undefined)
        {
            $('#edittask' + get['edittask']).click();
        }
    }
    
    function parseGET() 
    {
      var tmp = new Array();
      var tmp2 = new Array();
      var get = new Array();
      var url = location.search;

      if(url != '') {

        tmp = (url.substr(1)).split('&');

        for(var i=0; i < tmp.length; i++) {
          tmp2 = tmp[i].split('=');
          get[tmp2[0]] = tmp2[1];
        }
      }
        return get;
    }


</script>

